{
  "version": 2,
  "name": "faceinsight-flutter-web",
  "builds": [
    {
      "src": "flutter_app",
      "use": "@vercel/flutter-web",
      "config": {
        "buildCommand": "flutter build web --web-renderer html --dart-define API_BASE_URL=https://faceinsight-api.onrender.com/api/v1 --dart-define WS_BASE_URL=wss://faceinsight-api.onrender.com/ws --release",
        "outputDirectory": "build/web"
      }
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "destination": "/static/$1"
    },
    {
      "src": "/.*",
      "destination": "/index.html"
    }
  ],
  "env": {
    "API_BASE_URL": "@api_base_url",
    "WS_BASE_URL": "@ws_base_url"
  }
}
