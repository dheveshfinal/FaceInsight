{
  "version": 2,
  "buildCommand": "bash ./build.sh",
  "outputDirectory": "flutter_app/build/web",
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "destination": "/static/$1"
    },
    {
      "src": "/.*",
      "destination": "/index.html"
    }
  ]
}