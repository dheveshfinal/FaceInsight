{
  "version": 2,
  "name": "faceinsight-flutter-web",
  "builds": [
    {
      "src": "flutter_app",
      "use": "@vercel/flutter-web"
    }
  ],
  "routes": [
    {
      "src": "/static/(.*)",
      "headers": {
        "cache-control": "public, max-age=31536000, immutable"
      },
      "destination": "/static/$1"
    },
    {
      "src": "/.*",
      "destination": "/index.html"
    }
  ]
}
