# ==============================================================
#  FaceInsight – Flutter Frontend .env Configuration
#  Copy this to .env and fill in your actual values
#  These are passed via --dart-define during build
# ==============================================================

# ── API Base URLs ──────────────────────────────────────────
# Development
API_BASE_URL=http://localhost:8000/api/v1
WS_BASE_URL=ws://localhost:8000/ws

# Production (Render Backend)
# API_BASE_URL=https://your-backend.onrender.com/api/v1
# WS_BASE_URL=wss://your-backend.onrender.com/ws

# ── App Configuration ──────────────────────────────────────
APP_NAME=FaceInsight
APP_VERSION=1.0.0

# ── Feature Flags ──────────────────────────────────────────
ENABLE_ANALYTICS=true
ENABLE_CHAT=true
ENABLE_REPORTS=true
