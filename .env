# ==============================================================
#  FaceInsight – .env
#  Copy this to .env and fill in your values.
#  NEVER commit .env to git.
# ==============================================================

# ── App ────────────────────────────────────────────────────────
APP_NAME=FaceInsight
APP_ENV=development          # development | production
APP_DEBUG=true
APP_SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32_here
ALLOWED_HOSTS=localhost,127.0.0.1

# ── API ────────────────────────────────────────────────────────
API_V1_PREFIX=/api/v1
BACKEND_PORT=8000

# ── JWT ────────────────────────────────────────────────────────
JWT_SECRET_KEY=CHANGE_ME_another_secret_key_here
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── PostgreSQL ─────────────────────────────────────────────────
POSTGRES_USER=faceinsight
POSTGRES_PASSWORD=faceinsight_password
POSTGRES_DB=faceinsight_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Full async URL (built by docker-compose, but also usable standalone)
DATABASE_URL=postgresql+asyncpg://faceinsight:faceinsight_password@postgres:5432/faceinsight_db

# ── Redis ──────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=redis_secret_password
REDIS_URL=redis://:redis_secret_password@redis:6379/0

# ── Celery ─────────────────────────────────────────────────────
CELERY_BROKER=redis://:redis_secret_password@redis:6379/1
CELERY_BACKEND=redis://:redis_secret_password@redis:6379/2
CELERY_TASK_ALWAYS_EAGER=false     # set true to run tasks sync (debug)

# ── File Storage ───────────────────────────────────────────────
UPLOAD_DIR=/app/media/uploads
PROCESSED_DIR=/app/media/processed
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ── ML Models ──────────────────────────────────────────────────
ML_WEIGHTS_DIR=/app/ml/weights
# InsightFace model pack name (downloaded on first run)
INSIGHTFACE_MODEL=buffalo_l
# YOLOv8 model for acne detection (place .pt file in ml/weights/)
YOLO_ACNE_MODEL=yolov8n.pt
# Device: cpu | cuda  (Windows Docker Desktop has no CUDA — use cpu)
ML_DEVICE=cpu

# ── WebSocket ──────────────────────────────────────────────────
WS_HEARTBEAT_INTERVAL=30

# ── Rate Limiting ──────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_UPLOAD_PER_HOUR=20

# ── CORS ───────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost,http://localhost:80,http://localhost:8000,http://localhost:8080,http://localhost:8081,http://127.0.0.1:8080,http://127.0.0.1:8081

# ── Nginx ──────────────────────────────────────────────────────
NGINX_PORT=80

# ── Generative AI & Vector DB ──────────────────────────────────
GROQ_API_KEY=""
QDRANT_URL=http://qdrant:6333