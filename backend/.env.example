# ==============================================================
#  FaceInsight – Backend .env Configuration
#  Copy this to .env and fill in your actual values
# ==============================================================

# ── Application ────────────────────────────────────────────
APP_NAME=FaceInsight
APP_ENV=production
APP_DEBUG=False
APP_SECRET_KEY=your-super-secret-key-change-this
ALLOWED_HOSTS=localhost,127.0.0.1,your-render-app.onrender.com

# ── API ────────────────────────────────────────────────────
API_V1_PREFIX=/api/v1
BACKEND_PORT=8000

# ── JWT ────────────────────────────────────────────────────
JWT_SECRET_KEY=your-jwt-secret-key-change-this
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── PostgreSQL (Render Database) ───────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/database_name
POSTGRES_USER=faceinsight
POSTGRES_PASSWORD=your-postgres-password
POSTGRES_DB=faceinsight_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ── Redis (Render Redis) ───────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ── Celery (Background Tasks) ──────────────────────────────
CELERY_BROKER=redis://localhost:6379/0
CELERY_BACKEND=redis://localhost:6379/1
CELERY_TASK_ALWAYS_EAGER=False

# ── File Storage (Cloudinary) ──────────────────────────────
UPLOAD_DIR=/tmp/uploads
PROCESSED_DIR=/tmp/processed
MAX_UPLOAD_SIZE_MB=10
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/webp

# ── Optional: Cloudinary Integration ───────────────────────
# CLOUDINARY_CLOUD_NAME=your-cloud-name
# CLOUDINARY_API_KEY=your-api-key
# CLOUDINARY_API_SECRET=your-api-secret

# ── ML Models ──────────────────────────────────────────────
ML_WEIGHTS_DIR=/app/ml/weights
INSIGHTFACE_MODEL=buffalo_l
YOLO_ACNE_MODEL=yolov8n.pt
ML_DEVICE=cpu

# ── WebSocket ──────────────────────────────────────────────
WS_HEARTBEAT_INTERVAL=30

# ── Rate Limiting ──────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_UPLOAD_PER_HOUR=20

# ── CORS (Allow Frontend URLs) ─────────────────────────────
CORS_ORIGINS=http://localhost,http://localhost:3000,https://your-vercel-app.vercel.app

# ── Groq AI (LLM for Recommendations) ──────────────────────
GROQ_API_KEY=your-groq-api-key-here

# ── Qdrant (Vector Database for Embeddings) ───────────────
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
# For Qdrant Cloud, set:
#   QDRANT_URL=https://your-cluster.qdrant.io
#   QDRANT_API_KEY=your-api-key-from-qdrant-dashboard
