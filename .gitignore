# ==============================================================
#  FaceInsight – .gitignore
#  Prevent sensitive and unnecessary files from being committed
# ==============================================================

# ── Environment Variables ──────────────────────────────────
.env
.env.local
.env.*.local
.env.production
.env.development

# ── Backend Python ─────────────────────────────────────────
backend/__pycache__/
backend/*.py[cod]
backend/*$py.class
backend/*.so
backend/.Python
backend/build/
backend/develop-eggs/
backend/dist/
backend/downloads/
backend/eggs/
backend/.eggs/
backend/lib/
backend/lib64/
backend/parts/
backend/sdist/
backend/var/
backend/wheels/
backend/pip-wheel-metadata/
backend/.pytest_cache/
backend/.coverage
backend/htmlcov/
backend/.tox/
backend/.venv
backend/venv/
backend/env/
backend/*.egg-info/
backend/.installed.cfg
backend/*.egg

# ── Backend Media ──────────────────────────────────────────
backend/media/uploads/*
backend/media/processed/*
!backend/media/uploads/.gitkeep
!backend/media/processed/.gitkeep

# ── Backend ML Weights ─────────────────────────────────────
backend/ml/weights/*
backend/ml/models/*
!backend/ml/weights/.gitkeep
!backend/ml/models/.gitkeep

# ── Flutter ────────────────────────────────────────────────
flutter_app/.dart_tool/
flutter_app/.flutter-plugins
flutter_app/.flutter-plugins-dependencies
flutter_app/.packages
flutter_app/build/
flutter_app/.pub-cache/
flutter_app/.pub/
flutter_app/pubspec.lock
flutter_app/coverage/
flutter_app/.vscode/launch.json

# ── IDE & Editors ──────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.iml
*.ipr
*.iws

# ── OS Files ───────────────────────────────────────────────
Thumbs.db
.DS_Store
.env.swp

# ── Docker ─────────────────────────────────────────────────
docker-compose.override.yml
.dockerignore

# ── Git ────────────────────────────────────────────────────
.git/
.gitmodules

# ── Logs ───────────────────────────────────────────────────
*.log
logs/
*.out

# ── Node (if using npm) ────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Render/Vercel ──────────────────────────────────────────
.vercel/
.render/

# ── Keep examples ──────────────────────────────────────────
!.env.example
!/backend/.env.example
!/flutter_app/.env.example
